---
// Une page de contenu type, dans la mise en page de la home V1 : la ligne
// rouge en capitales, puis le héros en deux colonnes — l'accroche serif et
// les phrases à gauche, l'outil de suggestion à droite (là où la V1 mettait
// sa capture : ici c'est le vrai composant) — et le corps Markdown dessous.
import { getEntry, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import FivoSuggest from './fivo/FivoSuggest'
import { LANGUE_DEFAUT, type Langue } from '../i18n/langues'
import { traduire } from '../i18n/textes'

interface Props {
  /** L'identifiant de l'entrée dans src/content/pages, SANS la langue
   *  (« accueil », « series »…) : elle est retrouvée dans le dossier de la
   *  langue demandée. */
  entree: string
  /** La langue de la page. Le français vit à la racine de la collection, les
   *  autres dans leur dossier — comme les URL, dont le français n'a pas de
   *  préfixe. */
  langue?: Langue
  /** Le chemin sans préfixe de langue (« / », « /series »…). */
  chemin: string
}

const langue = Astro.props.langue ?? LANGUE_DEFAUT
const identifiant =
  langue === LANGUE_DEFAUT ? Astro.props.entree : `${langue}/${Astro.props.entree}`
const entree = await getEntry('pages', identifiant)
if (!entree) {
  throw new Error(`entrée de contenu introuvable : ${identifiant}`)
}
const { Content } = await render(entree)
const {
  titre,
  description,
  surTitre,
  accroche,
  phrases,
  univers,
  commentTitre,
  etapes,
  empreinteTitre,
  empreinte,
  salonsTitre,
  salonsTexte,
} = entree.data

// Le corps Markdown est facultatif : la home dit tout dans ses sections.
const corps = entree.body?.trim()

// Le libellé du CTA : la maquette dit « Je me lance ! » sur la home.
const cta = etapes ? 'cta.lance' : 'cta.suggestions'

// Le slider de la section empreinte : les mosaïques d'affiches carmin de la
// V1, une par univers, en fondu enchaîné.
const diapositives = [
  '/images/fond-image-Series.jpg',
  '/images/fond-image-Films.jpg',
  '/images/fond-image-Livres.jpg',
]

// Les ** du frontmatter deviennent des <strong> — c'est le seul balisage que
// le sur-titre connaît, inutile d'invoquer un moteur Markdown pour ça.
const sur_titre_html = surTitre
  ?.replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
---

<Base titre={titre} description={description} langue={langue} chemin={Astro.props.chemin}>
  <section class="heros">
    <div class="conteneur">
      {sur_titre_html && <p class="sur-titre" set:html={sur_titre_html} />}
      <div class="heros-grille">
        <div class="heros-texte">
          <h1>{accroche ?? titre}</h1>
          {phrases?.map((phrase) => <p>{phrase}</p>)}
          <a class="bouton-cta" href="#suggere-moi">{traduire(langue, cta)}</a>
        </div>
        <div class="heros-outil" id="suggere-moi">
          {/* L'îlot : le seul JavaScript de la page. `client:load` — c'est
              le cœur de l'expérience, on ne le fait pas attendre un scroll. */}
          <FivoSuggest client:load universInitial={univers} langue={langue} />
        </div>
      </div>
    </div>
  </section>

  {
    etapes && (
      <section class="accueil-section">
        <div class="conteneur">
          <h2>{commentTitre}</h2>
          <ol class="accueil-etapes">
            {etapes.map((etape, indice) => (
              <li>
                <span class="accueil-numero" aria-hidden="true">
                  {indice + 1}
                </span>
                <p>{etape}</p>
              </li>
            ))}
          </ol>
          <p class="accueil-cta">
            <a class="bouton-cta" href="#suggere-moi">
              {traduire(langue, cta)}
            </a>
          </p>
        </div>
      </section>
    )
  }

  {
    empreinte && (
      <section class="accueil-section accueil-empreinte">
        <div class="conteneur accueil-empreinte-grille">
          <div class="accueil-empreinte-texte">
            <h2>{empreinteTitre}</h2>
            {empreinte.map((paragraphe) => (
              <p>{paragraphe}</p>
            ))}
          </div>
          {/* Le fondu enchaîné est en CSS pur : trois images empilées, une
              animation décalée chacune — pas un octet de JavaScript. */}
          <div class="accueil-slider" aria-hidden="true">
            {diapositives.map((source) => (
              <img src={source} alt="" loading="lazy" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    salonsTitre && (
      <section class="accueil-section accueil-salons">
        <div class="conteneur">
          <h2>
            {salonsTitre}
            <span class="accueil-bientot">{traduire(langue, 'commun.bientot')}</span>
          </h2>
          <p>{salonsTexte}</p>
        </div>
      </section>
    )
  }

  {
    corps && (
      <article class="prose">
        <Content />
      </article>
    )
  }
</Base>
