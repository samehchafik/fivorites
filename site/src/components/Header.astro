---
// L'en-tête de la V1 : bandeau noir sous son liseré carmin, le logo
// « fivorites » à l'étoile, et les univers en capitales précédés de la puce
// ▶︎ (U+25B6 + sélecteur de variante texte — le même caractère que la V1).
//
// Il porte aussi le passage d'une langue à l'autre, dans un sélecteur qui se
// déplie. Deux choix à connaître :
//
// * **`<details>` et non un `<select>`** : le contenu reste quatre LIENS, avec
//   leurs URL et leurs `hreflang`. Un menu en JavaScript les cacherait aux
//   moteurs, et c'est exactement ce qu'on ne veut pas d'une page de
//   référencement. Le dépliement est natif — pas une ligne de script, et le
//   clavier le manipule sans qu'on ait rien à écrire.
// * **le drapeau porte le sélecteur replié** : quatre codes de langue en ligne
//   mangeaient un quart d'un écran de 375 px, le drapeau seul en prend un
//   dixième. Le nom de la langue reste écrit à côté sur grand écran, et sert
//   d'étiquette accessible partout — un drapeau ne dit pas une langue.
import {
  LANGUES,
  LANGUE_DRAPEAUX,
  LANGUE_NOMS,
  chemin_localise,
  type Langue,
} from '../i18n/langues'
import { traduire } from '../i18n/textes'
import CompteEntete from './CompteEntete'

interface Props {
  langue: Langue
  /** Le chemin SANS préfixe de langue (« / », « /series »…) : c'est lui
   *  qu'on traduit vers les autres langues. */
  chemin: string
}

const { langue, chemin } = Astro.props

const univers = [
  { chemin: '/series', cle: 'nav.series' as const },
  { chemin: '/films', cle: 'nav.films' as const },
  { chemin: '/livres', cle: 'nav.livres' as const },
]
---

<header class="entete">
  <div class="conteneur entete-barre">
    <a href={chemin_localise('/', langue)} class="logo">
      <span class="accessibilite">Fivorites</span>
    </a>
    <nav aria-label={traduire(langue, 'nav.aria')}>
      {
        univers.map((u) => (
          <a
            href={chemin_localise(u.chemin, langue)}
            aria-current={chemin === u.chemin ? 'page' : undefined}
          >
            <span class="fleche" aria-hidden="true">
              ▶︎
            </span>
            {traduire(langue, u.cle)}
          </a>
        ))
      }
    </nav>
    <details class="entete-langues">
      <summary aria-label={`${traduire(langue, 'nav.langues')} : ${LANGUE_NOMS[langue]}`}>
        <span class="drapeau" aria-hidden="true">{LANGUE_DRAPEAUX[langue]}</span>
        <span class="langue-long">{LANGUE_NOMS[langue]}</span>
        <span class="chevron" aria-hidden="true">▾</span>
      </summary>
      <nav aria-label={traduire(langue, 'nav.langues')}>
        {
          LANGUES.map((code) => (
            <a
              href={chemin_localise(chemin, code)}
              hreflang={code}
              lang={code}
              class={code === langue ? 'actif' : undefined}
              aria-current={code === langue ? 'true' : undefined}
            >
              <span class="drapeau" aria-hidden="true">{LANGUE_DRAPEAUX[code]}</span>
              {LANGUE_NOMS[code]}
            </a>
          ))
        }
      </nav>
    </details>
    {/* Le compte, tout à droite — l'icône du carnet du designer. `client:load` :
        l'état connecté doit se voir dès l'arrivée, pas après un scroll. */}
    <CompteEntete client:load langue={langue} />
  </div>
</header>
