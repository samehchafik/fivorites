---
// Le gabarit commun : tout ce qu'une page SEO doit porter — titre, meta
// description, Open Graph, langue — et rien d'interactif. Le JavaScript
// n'entre que par les îlots React que chaque page décide de monter.
//
// Exception assumée tant que `AVANT_PREMIERE` est vrai (src/config.ts) : la
// page est en `noindex` et une modale d'entrée la couvre — OK la révèle, le
// choix est retenu dans le navigateur. Son script tient en dix lignes,
// inline, et disparaît du HTML avec le drapeau.
import Header from '../components/Header.astro'
import { AVANT_PREMIERE } from '../config'
import { LANGUES, LANGUE_SENS, chemin_localise, type Langue } from '../i18n/langues'
import { traduire } from '../i18n/textes'
import '../styles/global.css'

interface Props {
  titre: string
  description: string
  /** La langue de la page. Elle décide de `lang`, de `dir`, des textes de la
   *  coque — et des `hreflang` qui disent aux moteurs que ces quatre pages
   *  sont la même, dans quatre langues. */
  langue: Langue
  /** Le chemin SANS préfixe de langue (« / », « /series »…). */
  chemin: string
}

const { titre, description, langue, chemin } = Astro.props
const sens = LANGUE_SENS[langue]

// L'URL canonique, bâtie sur `site` (astro.config.mjs) : c'est elle que les
// moteurs doivent retenir, quel que soit le chemin par lequel la page est
// arrivée (port direct, variantes d'hôte).
const canonique = new URL(Astro.url.pathname, Astro.site)

// Les variantes de langue de CETTE page. `x-default` désigne le français :
// c'est la version servie quand aucune des quatre ne correspond aux
// préférences du visiteur.
const variantes = LANGUES.map((code) => ({
  code,
  href: new URL(chemin_localise(chemin, code), Astro.site).href,
}))

// Le script du voile, en chaîne injectée par `set:html` : Astro n'évalue pas
// d'expression à l'intérieur d'un <script>, et un bloc JSX y deviendrait du
// texte inerte — mesuré ici même. Dix lignes : lever le voile si le
// navigateur se souvient (localStorage), sinon le poser et retenir le OK.
const script_voile = `(function () {
  var voile = document.getElementById('voile-avant-premiere')
  var lever = function () {
    voile.remove()
    document.documentElement.classList.remove('voile-pose')
  }
  try {
    if (localStorage.getItem('fivo-avant-premiere') === 'vu') { lever(); return }
  } catch (e) { /* navigation privée : la modale se remontre, sans gravité */ }
  document.documentElement.classList.add('voile-pose')
  document.getElementById('voile-ok').addEventListener('click', function () {
    try { localStorage.setItem('fivo-avant-premiere', 'vu') } catch (e) {}
    lever()
  })
  document.getElementById('voile-ok').focus()
})()`
---

<!doctype html>
<html lang={langue} dir={sens}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {AVANT_PREMIERE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonique} />
    {variantes.map((v) => <link rel="alternate" hreflang={v.code} href={v.href} />)}
    <link rel="alternate" hreflang="x-default" href={variantes[0].href} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={langue} />
    <meta property="og:url" content={canonique} />
    <meta name="generator" content={Astro.generator} />
    {
      AVANT_PREMIERE && (
        <noscript>
          <style>{`.voile { display: none; }`}</style>
        </noscript>
      )
    }
  </head>
  <body>
    {
      AVANT_PREMIERE && (
        <div class="voile" id="voile-avant-premiere" role="dialog" aria-modal="true" aria-labelledby="voile-titre">
          <div class="voile-panneau">
            <p class="voile-marque" aria-hidden="true">
              FIVO
            </p>
            <h1 id="voile-titre">{traduire(langue, 'voile.titre')}</h1>
            <p>{traduire(langue, 'voile.texte')}</p>
            <button type="button" id="voile-ok" class="bouton-cta">
              {traduire(langue, 'voile.ok')}
            </button>
          </div>
        </div>
      )
    }
    <Header langue={langue} chemin={chemin} />
    <main>
      <slot />
    </main>
    <footer class="pied">
      <div class="conteneur">
        <span>{traduire(langue, 'pied.baseline')}</span>
        <nav aria-label={traduire(langue, 'pied.aria')}>
          <a href={chemin_localise('/series', langue)}>{traduire(langue, 'nav.series')}</a>
          <a href={chemin_localise('/films', langue)}>{traduire(langue, 'nav.films')}</a>
          <a href={chemin_localise('/livres', langue)}>{traduire(langue, 'nav.livres')}</a>
        </nav>
      </div>
    </footer>
    {AVANT_PREMIERE && <script is:inline set:html={script_voile} />}
  </body>
</html>
