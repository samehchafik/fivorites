# Configuration du front d'administration. Copier en `admin/.env`.
#
# La base est celle de `sourcing` : l'administration lit ce que la collecte
# écrit. Les valeurs par défaut ci-dessous conviennent au poste de dev, où
# Postgres tourne sur la machine (jamais en conteneur).

# DATABASE_URL=postgresql://fivorites_v2@localhost:5432/fivorites_v2
# SOURCING_SCHEMA=sourcing

# Signature des cookies de session. **Obligatoire en production** : sans elle un
# secret est tiré au hasard à chaque démarrage, donc toute session saute au
# redémarrage et deux instances ne se reconnaissent pas.
#   openssl rand -hex 32
ADMIN_SECRET_KEY=

# Durée d'une session, en heures.
# SESSION_TTL_HOURS=12

# `Secure` sur le cookie : à mettre à true dès qu'un TLS est devant, à laisser
# à false en dev (http://localhost, le navigateur refuserait le cookie).
# COOKIE_SECURE=false

# HOST=127.0.0.1
# PORT=8182

# Origines autorisées à appeler l'API avec le cookie. Ne sert qu'en dev, où
# Vite (5173) et l'API (8182) sont deux origines distinctes ; en production
# l'API sert le front, même origine, et cette liste peut être vidée.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Langues proposées par le sélecteur. Garder aligné sur TMDB_SEASON_LANGUAGES
# côté sourcing : c'est cette liste-là qui décide de ce qui est collecté, donc
# de ce qu'il y a à afficher.
# SEASON_LANGUAGES=fr-FR,en-US,es-ES,ar-SA,tr-TR

# Durée de vie du cache des compteurs d'en-tête, en secondes. Ils balaient tout
# le brut : les recalculer à chaque affichage coûterait cher pour un chiffre
# d'avancement dont une minute de retard n'a aucune conséquence.
# SUMMARY_CACHE_SECONDS=60
