# Copier en `.env` (non versionné) et compléter.

# Authentification TMDB. Renseigner l'un OU l'autre ; le token v4 est prioritaire
# et préférable — il passe en en-tête, donc la clé ne se retrouve pas dans les
# URL journalisées.
TMDB_BEARER=
TMDB_API_KEY=

# Postgres local. Rôle et base créés par `make db-create`.
DATABASE_URL=postgresql://fivorites_v2@localhost:5432/fivorites_v2

# Requêtes par seconde vers TMDB. À remonter une fois qu'on aura mesuré les 429
# réellement observés — pas avant.
TMDB_RATE_LIMIT=20

# Débit vers les sources tierces de `enrich` (Wikidata, Wikipédia, TVmaze).
# Bien plus bas que TMDB : ce sont des services gratuits et partagés.
# ENRICH_RATE_LIMIT=2
